BasedOnStyle: WebKit
IndentWidth: 4
TabWidth: 4
AccessModifierOffset: -4
UseTab: Never
BreakBeforeBraces: Attach
SortIncludes: true
IncludeBlocks: Preserve
AlignAfterOpenBracket: DontAlign
IndentPPDirectives: BeforeHash
IncludeCategories:
    - Regex: '^<glad/'
      Priority: 1
    - Regex: '^<GLFW/'
      Priority: 2
    - Regex: '.*'
      Priority: 3
